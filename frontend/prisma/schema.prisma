generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model OddsSnapshot {
  id                  Int      @id @default(autoincrement())
  eventId             String   @map("event_id")
  fetchedAt           DateTime @map("fetched_at")
  source              String?
  correlationId       String?  @map("correlation_id")
  oddsPayloadJson     String   @map("odds_payload_json")
  upstreamPayloadJson String   @map("upstream_payload_json")

  @@index([eventId, fetchedAt], map: "idx_odds_snapshots_event_fetched")
  @@map("odds_snapshots")
}

model MatchStatsSnapshot {
  id                   Int      @id @default(autoincrement())
  eventId              String   @map("event_id")
  fetchedAt            DateTime @map("fetched_at")
  source               String?
  correlationId        String?  @map("correlation_id")
  matchStatsPayloadJson String  @map("match_stats_payload_json")
  feedPayloadsJson     String   @map("feed_payloads_json")

  @@index([eventId, fetchedAt], map: "idx_match_stats_snapshots_event_fetched")
  @@map("match_stats_snapshots")
}

model UpcomingFixture {
  eventId                String   @id @map("event_id")
  competitionPath        String   @map("competition_path")
  sport                  String?
  country                String?
  competition            String?
  homeTeamRaw            String?  @map("home_team_raw")
  awayTeamRaw            String?  @map("away_team_raw")
  startTimeUtc           String   @map("start_time_utc")
  roundLabel             String?  @map("round_label")
  discoveredAt           String   @map("discovered_at")
  lastRefreshedAt        String   @map("last_refreshed_at")
  lastOddsSnapshotAt     String?  @map("last_odds_snapshot_at")
  liveOddsSnapshotCount  Int      @default(0) @map("live_odds_snapshot_count")

  @@index([startTimeUtc, competitionPath], map: "idx_upcoming_fixtures_kickoff")
  @@map("upcoming_fixtures")
}

model UpcomingDiscoveryRun {
  id              Int     @id @default(autoincrement())
  competitionPath String  @map("competition_path")
  ranAt           String  @map("ran_at")
  fixturesFound   Int     @default(0) @map("fixtures_found")
  status          String
  error           String?

  @@index([competitionPath, ranAt(sort: Desc)], map: "idx_upcoming_discovery_runs_path_time")
  @@map("upcoming_discovery_runs")
}

model BetLabel {
  eventId             String  @id @map("event_id")
  sport               String
  country             String?
  competition         String?
  startTimeUtc        String? @map("start_time_utc")
  homeTeam            String? @map("home_team")
  awayTeam            String? @map("away_team")
  homeScore           Int     @map("home_score")
  awayScore           Int     @map("away_score")
  outcome1x2          String  @map("outcome_1x2")
  totalGoals          Int     @map("total_goals")
  over25              Int     @map("over_2_5")
  btts                Int
  homeGoalsFirstHalf  Int?    @map("home_goals_first_half")
  awayGoalsFirstHalf  Int?    @map("away_goals_first_half")
  derivedAt           String  @map("derived_at")

  @@index([startTimeUtc, sport, competition], map: "idx_bet_labels_kickoff")
  @@map("bet_labels")
}

model ClosingOdds {
  eventId       String  @map("event_id")
  bookmaker     String
  market        String
  selectionKey  String  @map("selection_key")
  decimalPrice  Float   @map("decimal_price")
  impliedProb   Float   @map("implied_prob")
  devigedProb   Float?  @map("devigged_prob")
  derivedAt     String  @map("derived_at")

  @@id([eventId, bookmaker, market, selectionKey])
  @@index([eventId, market], map: "idx_closing_odds_event_market")
  @@map("closing_odds")
}

model TeamEloHistory {
  eventId       String  @map("event_id")
  team          String
  side          String
  startTimeUtc  String  @map("start_time_utc")
  sport         String
  competition   String?
  preElo        Float   @map("pre_elo")
  postElo       Float   @map("post_elo")
  kFactor       Float   @map("k_factor")
  hfa           Float

  @@id([eventId, team])
  @@index([team, startTimeUtc], map: "idx_team_elo_history_team_time")
  @@map("team_elo_history")
}

model LiveOddsSnapshot {
  id            Int    @id @default(autoincrement())
  eventId       String @map("event_id")
  fetchedAt     String @map("fetched_at")
  bookmaker     String?
  market        String
  selectionKey  String @map("selection_key")
  decimalPrice  Float  @map("decimal_price")
  openingPrice  Float? @map("opening_price")

  @@index([eventId, fetchedAt], map: "idx_live_odds_snapshots_event_time")
  @@index([eventId, market, selectionKey, fetchedAt], map: "idx_live_odds_snapshots_event_selection")
  @@map("live_odds_snapshots")
}
