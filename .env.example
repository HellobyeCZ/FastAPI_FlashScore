# Hostnames below assume the FastAPI/worker run inside docker-compose
# (where service names like `postgres` / `redis` resolve via the compose
# network). For local dev where you run `uvicorn` on the host while only
# Postgres + Redis run in compose, swap `postgres` → `localhost` and
# `redis` → `localhost` in the URLs below.

# Database
POSTGRES_USER=flashscore
POSTGRES_PASSWORD=flashscore
POSTGRES_DB=flashscore
DATABASE_URL=postgresql+asyncpg://flashscore:flashscore@postgres:5432/flashscore

# Redis
REDIS_URL=redis://redis:6379/0

# Scraper credentials (REQUIRED — Task 12 makes these required-no-defaults).
# APP_STATS_FEED_SIGN: x-fsign header value rotated upstream by FlashScore.
#   Capture from a live browser session against livesport.cz; the app refuses
#   to start with this empty after Task 12 lands.
# APP_DEFAULT_HEADERS: JSON object of headers forwarded to upstream. The
#   placeholder below is a sane minimum; real production should mirror a
#   real browser's request headers (UA, Accept-Language, Origin, Referer).
APP_STATS_FEED_SIGN=
APP_DEFAULT_HEADERS={"Accept":"*/*","User-Agent":"Mozilla/5.0"}

# OpenTelemetry (optional — leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable)
OTEL_SERVICE_NAME=fastapi-flashscore
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Logging
LOG_LEVEL=INFO
