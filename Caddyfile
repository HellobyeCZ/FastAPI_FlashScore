:80 {
    # FastAPI routes are mounted at /, not /api/. Strip the /api prefix
    # before forwarding so /api/health → api:8000/health.
    handle_path /api/* {
        reverse_proxy api:8000
    }
    handle {
        reverse_proxy frontend:3000
    }
}
